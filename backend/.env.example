# ePayco Configuration
EPAYCO_PUBLIC_KEY=your_public_key_here
EPAYCO_PRIVATE_KEY=your_private_key_here

# ePayco API URLs
EPAYCO_AUTH_URL=https://apify.epayco.co/login
EPAYCO_SESSION_URL=https://apify.epayco.co/payment/session/create

# API Configuration
PORT=3001
NODE_ENV=development

# Domain Configuration
# Base URL del backend (usado para webhook de confirmación)
# Para desarrollo local con localtunnel, se genera automáticamente
# Para producción en Vercel, usar: https://your-backend.vercel.app
BACKEND_URL=http://localhost:3001

# URL de respuesta (página donde redirige después del pago)
# Para desarrollo local: http://localhost:3002/transaction-result.html
# Para producción: https://your-frontend.vercel.app/transaction-result.html
RESPONSE_URL=http://localhost:3002/transaction-result.html

# URL de confirmación (webhook de ePayco)
# Para desarrollo local con localtunnel, se genera automáticamente
# Para producción en Vercel: https://your-backend.vercel.app/api/checkout/confirmation
CONFIRMATION_URL=
BACKEND_URL=http://localhost:3001

# Response URL - URL donde ePayco redirigirá después del pago
# Esta debe ser la URL de tu frontend que mostrará el resultado
RESPONSE_URL=http://localhost:3002/transaction-result.html

# ePayco API URLs
EPAYCO_LOGIN_URL=https://apify.epayco.co/login
EPAYCO_SESSION_URL=https://apify.epayco.co/payment/session/create
EPAYCO_TRANSACTION_URL=https://secure.epayco.co/validation/v1/reference
